{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://araguaci.github.io/schemas/diario.entrada.schema.json",
  "title": "Entrada do Diário de Desenvolvimento",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "title",
    "category",
    "tags",
    "slug",
    "summary",
    "problem_statement",
    "key_learnings",
    "impact_value",
    "related_projects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEV-[0-9]{4}-[0-9]{3}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 12,
      "maxLength": 140
    },
    "category": {
      "type": "string",
      "enum": [
        "arquitetura",
        "backend",
        "conteudo",
        "devops",
        "frontend",
        "iot",
        "datascience",
        "ia",
        "infraestrutura",
        "osint",
        "saas",
        "seguranca",
        "segurança",
        "telefonia",
        "windows"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[^\\s,\\[\\]]+$"
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "problem_statement": {
      "type": "string",
      "minLength": 40
    },
    "key_learnings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "code_snippet": {
      "type": "string"
    },
    "impact_value": {
      "type": "string",
      "minLength": 20
    },
    "related_projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  }
}
